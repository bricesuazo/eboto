# Copy this file to .env before running the self-hosted Docker stack.

# Local Convex backend published ports.
PORT=3210
SITE_PROXY_PORT=3211
VITE_CONVEX_URL=http://localhost:3210
# Only needed for production image codegen against Convex Cloud. The Convex
# CLI does not support codegen against a self-hosted deployment.
CONVEX_DEPLOY_KEY=
CONVEX_URL=http://backend:3210
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
CONVEX_SITE_URL=http://localhost:3211
SITE_URL=http://localhost:3000

# Required only if you enable Convex Auth providers.
JWT_PRIVATE_KEY=
JWKS=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional local integrations. Leave blank to run without payments/email.
PAYMENTS_ENABLED=false
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=
BLAST_TRIGGER_SECRET=
DISCORD_WEBHOOK_URL=
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=